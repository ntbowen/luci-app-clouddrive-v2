#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=99

CONF="clouddrive2"

start_service() {
	local enabled install_path port user

	config_load "$CONF"
	config_get enabled "config" "enabled" "1"
	config_get install_path "config" "install_path" "/opt/clouddrive2"
	config_get port "config" "port" "19798"
	config_get user "config" "user" "root"

	[ "$enabled" = "1" ] || return 0

	local bin="$install_path/clouddrive"
	[ -x "$bin" ] || {
		logger -t clouddrive2 "Binary not found or not executable: $bin"
		return 0
	}

	# Ensure FUSE module is available
	[ -d /sys/fs/fuse ] || modprobe fuse 2>/dev/null || insmod fuse 2>/dev/null || true

	procd_open_instance
	procd_set_param command "$bin"
	procd_set_param respawn
	procd_set_param user "$user"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "/var/run/clouddrive2.pid"
	procd_close_instance
}

stop_service() {
	# procd handles PID; additional cleanup if needed
	true
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
